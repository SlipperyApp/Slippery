{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/cron/results", "schedule": "*/20 * * * *" },
    { "path": "/api/cron/retention", "schedule": "17 3 * * *" }
  ]
}

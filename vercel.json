{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/migrate.mjs && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/results",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    }
  ]
}
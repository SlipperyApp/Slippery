{
  "name": "slippery",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "e2e": "node --experimental-strip-types tests/e2e/run.ts",
    "verify": "npm run build && npm test && npm run fidelity && npm run e2e",
    "icons": "node tools/icons.mjs",
    "fidelity": "node --experimental-strip-types tests/e2e/fidelity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@neondatabase/serverless": "^0.10.4",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "axe-core": "^4.10.2",
    "drizzle-kit": "^0.30.2",
    "playwright-core": "^1.49.1",
    "server-only": "^0.0.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}

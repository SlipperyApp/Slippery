# Slippery environment. Set these in Vercel → Settings → Environment Variables.
# Never commit real values: this repo is public and GitHub's secret scanner
# will auto-revoke anything that lands in a commit.

# ─── already set in Vercel ────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # slip reading (/api/extract)
TELEGRAM_BOT_TOKEN=         # @SlipperyAppBot

# ─── needed for real accounts ─────────────────────────────────────────────
# Postgres. Vercel's Neon integration sets this for you in one click.
DATABASE_URL=
# Verification email. Gmail SMTP is the configured path: a Google account
# plus an APP PASSWORD (a normal password is refused, and 2-Step
# Verification must be on before Google will issue one).
#   Gmail sends ~500/day and rewrites From to the account's own address, so
#   MAIL_FROM can set the display name but not a different address.
GMAIL_USER=slipperyapp@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM="Slippery <slipperyapp@gmail.com>"
# Resend is the upgrade when this outgrows a personal mailbox. Either path
# works; Gmail wins if both are set.
RESEND_API_KEY=
#
# WITHOUT EITHER, SIGNUP STILL WORKS: accounts are created verified and
# signed in, because issuing a code nobody can receive would strand every
# signup. That means an address is unproven until one of these is set.

# ─── admin ────────────────────────────────────────────────────────────────
# Unlocks POST /api/admin/reset, which DELETES accounts so their emails and
# display names can be reused. Beta testing needs it; nothing else does.
# Unset, the route refuses outright — there is no fallback.
#   openssl rand -hex 32
# Then, to wipe every account:
#   curl -X POST https://slippery-iota.vercel.app/api/admin/reset \
#     -H "x-admin-secret: <the value>" -H "content-type: application/json" \
#     -d '{"scope":"accounts"}'
# scope is one of: accounts (everything), bets (keep accounts), sessions
# (sign everyone out). There is no default: a request without one deletes
# nothing rather than everything.
ADMIN_SECRET=

# ─── recommended, but the app runs without them ───────────────────────────
# Telegram echoes this on every update. WITHOUT IT THE BOT STILL RUNS, but
# the webhook URL will accept forged updates from anyone who guesses it.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── live settlement ──────────────────────────────────────────────────────
# Results are SCRAPED, no API needed. The sources are tried in order, the
# approach soccerdata takes: never depend on one site.
#   espn, sofascore        best data, both refuse datacenter IPs today
#   football-data-uk       static CSVs, league football only, always answers
#   flashscore             the feed its own front end reads. Football AND
#                          tennis, and the leagues outside Europe the CSVs
#                          do not cover
#   football-data          needs a token, last resort
#
# Everything is graded on the 90-minute score, so a source that cannot prove
# one does not get to settle. football-data.co.uk is league-only, which is
# the proof. FlashScore is filtered per competition for the same reason: a
# cup tie comes back with a status the engine refuses.
#
# Racing is never auto-settled. Place terms, each-way fractions and rule 4
# deductions are set per race by the bookmaker and are in no feed, so racing
# bets are tracked and settled by hand in one tap.
#
# These block by IP reputation and every host gets a different answer. GET
# /api/sources from the deployment itself reports what it can actually
# reach. Nothing below is required for the app to boot.
#   football-data free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
# Pin one source by name: espn | sofascore | football-data-uk | flashscore |
# football-data | off. Unset tries them in order, which is what you want.
RESULTS_PROVIDER=
SCRAPE_UA=                  # optional override for the scrapers' User-Agent
SOFASCORE_UA=               # legacy alias, SofaScore only
# Protects /api/results from being called by anyone. WITHOUT IT THE SWEEP
# STILL RUNS: it falls back to trusting Vercel's own x-vercel-cron header,
# which is forgeable. Worst case is a wasted lookup, but set it anyway.
#   openssl rand -hex 32
CRON_SECRET=

# ─── optional ─────────────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://slippery-iota.vercel.app
EXTRACT_MODEL=claude-haiku-4-5

# Slippery environment. Set these in Vercel → Settings → Environment Variables.
# Never commit real values: this repo is public and GitHub's secret scanner
# will auto-revoke anything that lands in a commit.

# ─── already set in Vercel ────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # slip reading (/api/extract)
TELEGRAM_BOT_TOKEN=         # @SlipperyAppBot

# ─── needed for real accounts ─────────────────────────────────────────────
# Postgres. Vercel's Neon integration sets this for you in one click.
DATABASE_URL=
# Transactional email for verification codes. resend.com, free tier is plenty.
RESEND_API_KEY=
MAIL_FROM="Slippery <hello@yourdomain>"   # must be a domain verified in Resend

# ─── needed for the Telegram webhook ──────────────────────────────────────
# Any long random string. Telegram echoes it on every update; without it the
# public webhook URL would accept forged updates from anyone.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── needed for live settlement ───────────────────────────────────────────
# football-data.org free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
# Which provider the settlement sweep asks first. Set to `sofascore` to use
# SofaScore, which publishes the 90-minute score on knockout ties and so
# settles extra-time games that football-data.org can only ask about.
# Caveat: SofaScore refuses datacenter IPs with a 403, which is what a Vercel
# function has. Keep FOOTBALL_DATA_TOKEN set alongside it — the sweep falls
# back automatically rather than leaving bets unsettled.
RESULTS_PROVIDER=
SOFASCORE_UA=               # optional override for the request User-Agent
# Protects /api/results from being called by anyone to burn the feed's quota.
#   openssl rand -hex 32
CRON_SECRET=

# ─── optional ─────────────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://slippery-iota.vercel.app
EXTRACT_MODEL=claude-haiku-4-5
